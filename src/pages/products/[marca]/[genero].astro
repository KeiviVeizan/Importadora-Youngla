---
import Layout from "../../../layouts/Layout.astro"
import ProductsHero from "../../../components/products/ProductsHero.astro"
import ProductHanger from "../../../components/products/ProductHanger.astro"
import { marcas, generos, productos } from "../../../data/productos"

export function getStaticPaths() {
    return marcas.flatMap((marca) =>
        generos.map((genero) => ({
            params: { marca: marca.id, genero: genero.id },
            props: {
                marca,
                genero,
                lista: productos.filter((p) => p.marca === marca.id && p.genero === genero.id),
            },
        })),
    )
}

const { marca, genero, lista } = Astro.props
---
<Layout title={`${marca.nombre} ${genero.nombre} | Importadora Altum`}>
    <main>
        <ProductsHero
            migas={[
                { nombre: "Inicio", href: "/" },
                { nombre: "Productos", href: "/products" },
                { nombre: marca.nombre, href: `/products/${marca.id}` },
                { nombre: genero.nombre },
            ]}
            titulo={`${marca.nombre} · ${genero.nombre}`}
            subtitulo={`${lista.length} ${lista.length === 1 ? "producto" : "productos"}`}
        />
        {
            lista.length > 0 ? (
                <ul class="productos-grid perchero">
                    {lista.map((p, i) => <ProductHanger producto={p} indice={i} delay={(i % 4) * 80} />)}
                </ul>
            ) : (
                <p class="vacio">Pronto tendremos productos en esta sección.</p>
            )
        }
    </main>
</Layout>
<style>
    .productos-grid{
        width: 100%;
        max-width: 90%;
        margin: 0 auto 4rem;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 3.5rem 1.2rem;
    }
    .vacio{
        width: 100%;
        max-width: 90%;
        margin: 2rem auto 4rem;
        color: var(--color-muted);
    }
    @media (min-width: 768px){
        .productos-grid{
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (min-width: 1024px){
        .productos-grid{
            max-width: min(90%, 80rem);
            gap: 4rem 2rem;
        }
        .vacio{
            max-width: min(90%, 80rem);
        }
    }
</style>
<script>
    import "../../../scripts/home-animations"
</script>
