---
import Layout from "../../../../layouts/Layout.astro"
import PrendaColgada from "../../../../components/products/PrendaColgada.astro"
import CajaPedido from "../../../../components/products/CajaPedido.astro"
import { marcas, generos, productos } from "../../../../data/productos"
import { CONFIG } from "../../../../scripts/calculadora-config"

export function getStaticPaths() {
    return productos.map((producto) => {
        const marca = marcas.find((m) => m.id === producto.marca)!
        const genero = generos.find((g) => g.id === producto.genero)!
        const otros = productos.filter((p) => p.marca === marca.id && p.genero === genero.id && p.id !== producto.id).slice(0, 2)
        return {
            params: { marca: marca.id, genero: genero.id, producto: producto.id },
            props: { producto, marca, genero, otros },
        }
    })
}

const { producto, marca, genero, otros } = Astro.props
const volver = `/products/${marca.id}/${genero.id}`
const urlFicha = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
const consulta = `Hola, quiero consultar por: ${producto.nombre} (${marca.nombre}, ${genero.nombre}) - $${producto.precio} USD. ${urlFicha}`
const fallbackHref = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(consulta)}`
---
<Layout title={`${producto.nombre} · ${marca.nombre} | Importadora Altum`}>
    <main
        class="ficha"
        data-ficha
        data-nombre={producto.nombre}
        data-marca={marca.nombre}
        data-genero={genero.nombre}
        data-precio={producto.precio}
        data-url={urlFicha}
        data-disponible={producto.disponible ? "1" : "0"}
    >
        <div class="fondo" aria-hidden="true">
            <div class="otros">
                {otros.map((o) => <img src={o.imagen.src} alt="" loading="lazy" decoding="async" />)}
            </div>
        </div>

        <header class="barra">
            <a class="volver" href={volver} aria-label={`Volver a ${marca.nombre} ${genero.nombre}`}>←</a>
            <h1>{producto.nombre}</h1>
            <span class="barra-marca">{marca.nombre} · {genero.nombre}</span>
        </header>

        <section class="escena" data-carrusel data-fotos={JSON.stringify(producto.fotos)}>
            <span class="marca-fondo" aria-hidden="true">{marca.nombre}</span>
            <div class="prenda">
                <PrendaColgada
                    data-foto
                    src={producto.imagen.src}
                    alt={producto.imagen.alt}
                    tipo={producto.tipo}
                    meta={producto.meta}
                    vtName={`prenda-${producto.id}`}
                    loading="eager"
                />
            </div>
            {
                producto.fotos.length > 1 && (
                    <div class="carrusel" role="group" aria-label="Fotos del producto">
                        <button type="button" class="flecha" data-ant aria-label="Foto anterior">‹</button>
                        <ol class="puntos">
                            {producto.fotos.map((f: { alt: string }, i: number) => (
                                <li><button type="button" data-punto={i} aria-label={`Ver foto ${i + 1}: ${f.alt}`} aria-current={i === 0 ? "true" : undefined}></button></li>
                            ))}
                        </ol>
                        <button type="button" class="flecha" data-sig aria-label="Foto siguiente">›</button>
                        <p class="sr" aria-live="polite" data-estado>Foto 1 de {producto.fotos.length}</p>
                    </div>
                )
            }
        </section>

        <fieldset class="tallas" data-tallas>
            <legend>Talla</legend>
            {
                producto.tallas.map((t: string) => (
                    <label>
                        <input type="radio" name="talla" value={t} checked={producto.tallas.length === 1} />
                        <span>{t}</span>
                    </label>
                ))
            }
        </fieldset>

        <div class="precio">
            <span class="usd">$</span><strong>{producto.precio.toFixed(2)}</strong>
            <small>USD</small>
        </div>

        <div class="zona-pedido">
            <CajaPedido marca={marca.nombre} disponible={producto.disponible} fallbackHref={fallbackHref} />
        </div>
    </main>
</Layout>
<style>
    .ficha{
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 100svh;
        padding: 5.5rem 5% 0;
        overflow: hidden;
        background: #f3f2ee;
    }
    .fondo{
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }
    .otros{
        position: absolute;
        top: 8rem;
        bottom: 12rem;
        left: 6%;
        right: 6%;
        display: none;
        align-items: center;
        justify-content: space-between;
        filter: blur(7px);
        opacity: .22;
    }
    .otros img{ width: 20%; max-height: 100%; object-fit: contain; }

    .barra{
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .2rem;
        text-align: center;
        padding-top: .6rem;
    }
    .volver{
        position: absolute;
        left: 0;
        top: .6rem;
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border: 1px solid var(--color-border-soft);
        border-radius: .9rem;
        background: #fff;
        color: var(--color-dark);
        text-decoration: none;
    }
    h1{
        padding: 0 3.2rem;
        font-size: 1.25rem;
        color: var(--color-dark);
        letter-spacing: var(--letter-spacing-text);
        text-wrap: balance;
    }
    .barra-marca{ font-size: .78rem; color: var(--color-muted); }

    .escena{
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 1rem 0;
    }
    /* Marca grande y discreta, vertical, centrada detrás de la prenda */
    .marca-fondo{
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        writing-mode: vertical-rl;
        font-size: clamp(3rem, 9vw, 5rem);
        font-weight: 900;
        line-height: 1;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: -.02em;
        color: rgba(22, 29, 8, .07);
        pointer-events: none;
        user-select: none;
    }
    .prenda{
        position: relative;
        z-index: 2;
        width: min(86vw, 30rem);
        will-change: transform;
    }

    /* Carrusel: flechas y puntos debajo de la prenda */
    .carrusel{
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: .9rem;
    }
    .flecha{
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        padding: 0 0 .15rem;
        border: 1px solid var(--color-border-soft);
        border-radius: 50%;
        background: #fff;
        color: var(--color-dark);
        font: inherit;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        transition: background .2s, color .2s;
    }
    .flecha:hover{ background: var(--color-dark); color: #fff; }
    .flecha:focus-visible, .puntos button:focus-visible{ outline: 2px solid var(--color-text-a-hover); outline-offset: 2px; }
    .puntos{
        display: flex;
        gap: .2rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .puntos button{
        position: relative;
        width: 1.4rem;
        height: 1.4rem;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
    }
    .puntos button::after{
        content: "";
        position: absolute;
        inset: 0;
        margin: auto;
        width: .5rem;
        height: .5rem;
        border-radius: 50%;
        background: #b9b7b0;
        transition: background .2s, transform .2s;
    }
    .puntos button[aria-current="true"]::after{ background: var(--color-dark); transform: scale(1.4); }
    .sr{
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* Tallas a la izquierda, encima de la escena (como la ref. móvil) */
    .tallas{
        position: absolute;
        z-index: 3;
        left: 5%;
        top: 9rem;
        display: flex;
        flex-direction: column;
        gap: .55rem;
        border: 0;
    }
    .tallas legend{ margin-bottom: .6rem; font-weight: 700; color: var(--color-dark); }
    .tallas label{ display: block; cursor: pointer; }
    .tallas input{ position: absolute; opacity: 0; pointer-events: none; }
    .tallas span{
        display: grid;
        place-items: center;
        width: 3.2rem;
        height: 2.8rem;
        border: 1px solid var(--color-border-soft);
        border-radius: .9rem;
        background: rgba(255, 255, 255, .75);
        color: var(--color-dark);
        font-weight: 500;
        transition: border-color .2s, background .2s;
    }
    .tallas input:checked + span{ border: 2px solid var(--color-dark); background: #fff; }
    .tallas input:focus-visible + span{ outline: 2px solid var(--color-text-a-hover); outline-offset: 2px; }
    .tallas.pedir span{ border-color: var(--color-border); animation: sacudir .4s; }
    @keyframes sacudir{
        0%, 100%{ transform: translateX(0); }
        25%{ transform: translateX(-5px); }
        75%{ transform: translateX(5px); }
    }

    .precio{
        position: absolute;
        z-index: 3;
        left: 5%;
        bottom: 10.5rem;
        display: flex;
        align-items: baseline;
        gap: .1rem;
        color: var(--color-dark);
    }
    .precio .usd{ font-size: 1.1rem; font-weight: 700; }
    .precio strong{ font-size: 1.9rem; letter-spacing: -.03em; }
    .precio small{ margin-left: .3rem; font-size: .7rem; color: var(--color-muted); }

    .zona-pedido{
        position: relative;
        z-index: 3;
        padding-top: .5rem;
    }


    @media (min-width: 1024px){
        .ficha{ padding-top: 6.5rem; }
        .otros{ display: flex; }
        h1{ font-size: 1.6rem; }
        .prenda{ width: 28rem; }
        .marca-fondo{ font-size: 7rem; }
        .tallas, .precio{ left: calc(50% - 21rem); }
    }
</style>
<script>
    import "../../../../scripts/home-animations"
    import "../../../../scripts/producto-caja"
    import "../../../../scripts/producto-carrusel"
</script>
