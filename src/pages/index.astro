---
import Layout from "../layouts/Layout.astro"
import {ArrowRight, ShieldCheck} from "@lucide/astro"
import InformationHome from "../components/information-home.astro"
import MarcasHome from "../components/Section1-Home.astro"
---

<Layout>
	<main>
		<section class="pag-inicio">
			<div class="imagen"></div>
			<div class="section-text-inicio">
				<h1>Ropa que impulsa  <span class="h1-color">Tu mejor Versión</span></h1>
				<p>
					Importamos las mejores marcas del mundo para potenciar tu entrenamiento y tu estilo.
				</p>
				<div class="section-text-final">
					<a href="/">Explorar Colección <ArrowRight size="1em"/></a>
					<p><ShieldCheck size="1em"/>Productos 100% originales</p>
				</div>
			</div>
		</section>
		<MarcasHome/>
		<InformationHome/>
	</main>
</Layout>
<style>
	.pag-inicio{
		position: relative;
		width: 100%;
		height: 100vh;
	}
	.imagen{
		position: absolute;
		inset: 0;
		background-image: url('/images/fondo-principal.png');
		background-position: 60% 15% ;
		background-repeat: no-repeat;
		background-size: cover;		

		width: 100%;
		height: 100vh;
	}
	.section-text-inicio{
		width: 100%;
		height: 100dvh;
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: start;
		padding: 6rem 0rem 0rem 2rem;
		
	}
	.section-text-inicio h1{
		color: var(--color-text-h1);
		max-width: 65%;
		margin: 1rem 0rem;
		font-size: clamp(var(--font-size-small-h1),var(--font-size-medium-h1),var(--font-size-desktop-h1));
		letter-spacing: var(--letter-spacing-h1);
		}
	.h1-color{
		color: var(--color-text-h1-sp);
	}
	.section-text-final{
		width: 100%;
	}
	.section-text-final a{
		display: inline-flex;
		align-items:center;
		gap: .5rem;
		background-color: var(--color-button);
		padding: 1rem;
		border-radius: 3rem;
		text-decoration: none;
		color: var(--color-text-button);
		margin: 1rem 0rem;
		font-size: clamp(var(--font-size-small),var(--font-size-medium),var(--font-size-desktop));
	}
	.pag-inicio p{
		max-width: 60%;
		color: white;
		font-size: clamp(var(--font-size-small),var(--font-size-medium),var(--font-size-desktop));
		line-height: 1.4;
		letter-spacing: var(--letter-spacing-p);
	}
	.section-text-final p{
		display: flex;
		align-items: center;
		gap: .3rem;
	}
	@media(min-width: 1024px){
		.section-text-inicio h1{
			max-width: 48%;
			font-size: 4rem;
		}
		.section-text-inicio p{
			max-width: 43%;
		}
		.section-text-final{
			display: flex;
			flex-direction: row;
			align-items: center;
			max-width: 45%;
		}
		.section-text-final a{
			margin-right: 3rem;
		}
		.section-text-final p{
			max-width: 43%;
		}
	}
</style>