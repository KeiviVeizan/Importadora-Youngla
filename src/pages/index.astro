---
import Layout from "../layouts/Layout.astro"
---

<Layout>
	<main>
		<section class="pag-inicio">
			<div class="imagen"></div>
			<div class="section-text-inicio">
				<h1>Ropa que impulsa  <span class="h1-color">Tu mejor Versión</span></h1>
				<p>
					importamos las mejores marcas del mundo para potenciar tu entrenamiento y tu estilo.
				</p>
				<div class="section-text-final">
					<a href="/">Explorar Colección</a>
					<p>Productos 100% originales</p>
				</div>
			</div>
		</section>
	</main>
</Layout>
<style>
	.pag-inicio{
		position: relative;
		width: 100%;
		height: 100dvh;
	}
	.imagen{
		position: absolute;
		inset: 0;
		background-image: url('/images/fondo-principal.png');
		background-position: 60% 15% ;
		background-repeat: no-repeat;
		background-size: cover;		

		width: 100%;
		height: 100dvh;
	}
	.section-text-inicio{
		width: 100%;
		height: 100dvh;
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: start;
		padding: 6rem 0rem 0rem 2rem;
		
	}
	.section-text-inicio h1{
		color: var(--color-text-h1);
		max-width: 65%;
		margin: 1rem 0rem;
	}
	.h1-color{
		color: var(--color-text-h1-sp);
	}
	.section-text-final, .section-text-inicio p{
		max-width: 60%;
		color: white;
	}
	.section-text-final a{
		display: inline-block;
		background-color: var(--color-button);
		padding: 1rem;
		border-radius: 3rem;
		text-decoration: none;
		color: var(--color-text-button);
		margin: 1rem 0rem;
	}
	.section-text-final p{
		font-size: .65rem;
	}
</style>