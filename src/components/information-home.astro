---
const InformationHome =[
	{
		id:"1",
		description:"Somos la Empresa numero 1 en bolivia en ropas deportivas",
		image:"/images/fondo-principal.png"
	},
	{
		id:"2",
		description:"Lorem ipsum dolor sit amet consectetur adipisicing elit. Error temporibus enim, excepturi ipsum dolor corrupti assumenda magni tempore id ullam! Minima beatae vitae soluta officiis? Excepturi repellat ipsa exercitationem quae.",
		image:"/images/fondo-principal.png"
	},
	{
		id:"3",
		description:"Lorem ipsum dolor sit amet consectetur adipisicing elit. Error temporibus enim, excepturi ipsum dolor corrupti assumenda magni tempore id ullam! Minima beatae vitae soluta officiis? Excepturi repellat ipsa exercitationem quae.",
		image:"/images/fondo-principal.png"
	}
]
---
<section class="info-home">
    {
        InformationHome.map((home)=>(
            <div class={`info-card info-card${home.id}`}>
                <div class="info-interna">
                    <p>{home.description}</p>
                    <img src={home.image} alt="Imagen de descripción de lo que hace la empresa"/>
                </div>
            </div>
        ))
    }
</section>
<style>
    .info-home{
        width: 100%;
        max-width: 90%;
        margin: 1rem auto;
    }
    .info-card{
        display: flex;
        flex-direction: column;
        margin: 2rem auto;
    }
    .info-interna{
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .info-interna p{
        font-size: clamp(var(--font-size-small),var(--font-size-medium),var(--font-size-desktop));
        text-align: justify;
        letter-spacing: var(--letter-spacing-text);
    }
    .info-interna img{
        border-radius: 1.2rem;
    }
    @media(min-width: 768px){
        .info-card{
            max-width: 80%;
        }
    }
    @media(min-width: 1024px){
        .info-card{
            width: 95%;
        }
        .info-interna{
            flex-direction: row;
            justify-content: space-evenly;
            align-items: center;
        }
        .info-interna p{
            text-align: left;
            width: 40%;
        }
        .info-interna img{
            width: 20rem;
        }
        .info-card:nth-child(even) .info-interna{
            flex-direction: row-reverse;
        }
        .info-card:nth-child(even) .info-interna p{
            text-align: right;
        }
    }

</style>