---
import { Search, CreditCard, Plane, Package } from "@lucide/astro"
import SectionTitle from "./SectionTitle.astro"

// Para cambiar un paso: edita este arreglo. El orden define la numeración.
const pasos = [
    { icon: Search, title: "Encuentra el producto", description: "Elige uno de nuestros productos disponibles o envíanos el enlace de la marca que buscas." },
    { icon: CreditCard, title: "Reserva tu pedido", description: "Para confirmar la importación solicitamos un anticipo del 50% del valor total." },
    { icon: Plane, title: "Importamos desde USA", description: "Nos encargamos de la compra, impuestos y todo el proceso de importación." },
    { icon: Package, title: "Recíbelo en Bolivia", description: "Cuando tu pedido llega, cancelas el saldo restante y coordinamos la entrega." },
]
---
<section class="como-funciona" aria-labelledby="como-funciona-titulo">
    <SectionTitle eyebrow="Importadora Altum" title="¿Cómo funciona?" id="como-funciona-titulo" />
    <ol class="pasos" data-timeline>
        <span class="linea" aria-hidden="true"><span class="linea-relleno"></span></span>
        {
            pasos.map((paso, i) => (
                <li class="paso" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                    <span class="paso-numero" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <div class="paso-icono">
                        <paso.icon size="1.6rem" stroke-width={1.5} />
                        <span class="paso-badge">{i + 1}</span>
                    </div>
                    <div class="paso-texto">
                        <h3>{paso.title}</h3>
                        <p>{paso.description}</p>
                    </div>
                </li>
            ))
        }
    </ol>
</section>
<style>
    .como-funciona{
        width: 100%;
        max-width: 90%;
        margin: 3rem auto;
    }
    .pasos{
        position: relative;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 34rem;
        margin: 0 auto;
    }
    /* Línea de la timeline: pasa por el centro de los íconos (3.5rem de caja + padding .75rem) */
    .linea{
        position: absolute;
        left: calc(.75rem + 1.75rem - 1px);
        top: 2.5rem;
        bottom: 2.5rem;
        width: 2px;
        background: var(--color-border-soft);
        border-radius: 2px;
        overflow: hidden;
        z-index: 1; /* por encima del fondo de las tarjetas, por debajo de los íconos */
    }
    .linea-relleno{
        display: block;
        width: 100%;
        height: 100%;
        background: var(--color-button);
        transform-origin: top;
        transform: scaleY(var(--progress, 0));
    }
    .paso{
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: .75rem;
        background: var(--color-gray-bg);
        border-radius: 1.2rem;
        overflow: hidden;
    }
    .paso-numero{
        position: absolute;
        right: .75rem;
        top: -.4rem;
        font-size: 4.5rem;
        font-weight: 800;
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 1px var(--color-border-soft);
        pointer-events: none;
        user-select: none;
    }
    .paso-icono{
        position: relative;
        z-index: 2;
        flex: none;
        display: grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        background: #fff;
        border-radius: 1rem;
        color: var(--color-dark);
        box-shadow: 0 .25rem .9rem rgba(0,0,0,.08);
        transition: transform .3s var(--ease-out), background-color .3s;
    }
    .paso:hover .paso-icono{
        transform: translateY(-3px) rotate(-4deg);
        background: var(--color-button);
    }
    .paso-badge{
        position: absolute;
        top: -.35rem;
        right: -.35rem;
        display: grid;
        place-items: center;
        width: 1.2rem;
        height: 1.2rem;
        border-radius: 50%;
        background: var(--color-button);
        color: var(--color-text-button);
        font-size: .7rem;
        font-weight: 700;
    }
    .paso-texto{
        position: relative;
        z-index: 2;
    }
    .paso-texto h3{
        font-size: 1rem;
        color: var(--color-dark);
        margin-bottom: .2rem;
    }
    .paso-texto p{
        font-size: .875rem;
        line-height: 1.4;
        color: var(--color-muted);
        letter-spacing: var(--letter-spacing-text);
    }
    @media(min-width: 1024px){
        .como-funciona{
            max-width: 80rem;
        }
        .pasos{
            flex-direction: row;
            align-items: stretch;
            max-width: none;
            gap: 1.25rem;
        }
        .linea{
            left: 3rem;
            right: 3rem;
            top: calc(1.25rem + 1.75rem - 1px);
            bottom: auto;
            width: auto;
            height: 2px;
        }
        .linea-relleno{
            transform-origin: left;
            transform: scaleX(var(--progress, 0));
        }
        .paso{
            flex: 1;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.25rem;
            padding: 1.25rem;
            min-height: 14rem;
        }
        .paso-numero{
            top: auto;
            bottom: -.6rem;
            right: 1rem;
            font-size: 6rem;
        }
        .paso-texto h3{
            font-size: 1.15rem;
        }
        .paso-texto p{
            font-size: .95rem;
        }
    }
</style>
