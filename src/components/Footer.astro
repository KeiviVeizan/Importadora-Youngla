---
import { MessageCircle, Mail, MapPin, ShieldCheck } from "@lucide/astro"

const anio = new Date().getFullYear()

const navegacion = [
    { nombre: "Inicio", href: "/" },
    { nombre: "Acerca de Nosotros", href: "/about-us" },
    { nombre: "Productos", href: "/products" },
]

// Mismos href que categorias-home.astro
const categorias = [
    { nombre: "Hombre", href: "/products?categoria=hombre" },
    { nombre: "Mujer", href: "/products?categoria=mujer" },
    { nombre: "Accesorios", href: "/products?categoria=accesorios" },
]

// TODO: reemplazar email y ciudad por los datos reales.
const whatsapp = "https://wa.me/59173532233?text=" + encodeURIComponent("Hola, quiero más información sobre sus productos.")
const email = "contacto@altum.com"
const ciudad = "Bolivia"

// TODO: reemplazar las URLs por las cuentas reales.
// Lucide v1 no incluye íconos de marca: se usan SVG inline. "relleno" = true usa fill, false usa trazo.
const redes = [
    {
        nombre: "Instagram",
        href: "https://instagram.com/altum",
        relleno: false,
        svg: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
    },
    {
        nombre: "TikTok",
        href: "https://tiktok.com/@altum",
        relleno: true,
        svg: '<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>',
    },
    {
        nombre: "Facebook",
        href: "https://facebook.com/altum",
        relleno: false,
        svg: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
    },
]
---
<footer class="footer" aria-labelledby="footer-titulo">
    <div class="footer-card" data-reveal>
        <div class="footer-top">
            <h2 id="footer-titulo" class="footer-logo">ALTUM</h2>
            <p class="footer-tagline">Importamos las mejores marcas del mundo para potenciar tu entrenamiento y tu estilo.</p>
        </div>
        <hr />
        <div class="footer-grid">
            <nav aria-label="Navegación del pie de página">
                <h3>Navegación</h3>
                <ul>
                    {navegacion.map((l) => <li><a href={l.href}>{l.nombre}</a></li>)}
                </ul>
            </nav>
            <nav aria-label="Categorías">
                <h3>Categorías</h3>
                <ul>
                    {categorias.map((l) => <li><a href={l.href}>{l.nombre}</a></li>)}
                </ul>
            </nav>
            <address>
                <h3>Contacto</h3>
                <ul>
                    <li>
                        <a href={whatsapp} target="_blank" rel="noopener noreferrer">
                            <span class="icono"><MessageCircle size="1em" /></span> WhatsApp
                        </a>
                    </li>
                    <li>
                        <a href={`mailto:${email}`}>
                            <span class="icono"><Mail size="1em" /></span> {email}
                        </a>
                    </li>
                    <li class="dato">
                        <span class="icono"><MapPin size="1em" /></span> {ciudad}
                    </li>
                </ul>
            </address>
            <div class="footer-redes">
                <h3>Síguenos</h3>
                <ul>
                    {
                        redes.map((r) => (
                            <li>
                                <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={`${r.nombre} de Altum`}>
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="20"
                                        height="20"
                                        aria-hidden="true"
                                        focusable="false"
                                        fill={r.relleno ? "currentColor" : "none"}
                                        stroke={r.relleno ? "none" : "currentColor"}
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        set:html={r.svg}
                                    />
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
        <hr />
        <div class="footer-bottom">
            <p>© {anio} Importadora Altum. Todos los derechos reservados.</p>
            <p class="footer-original"><ShieldCheck size="1em" /> Productos 100% originales</p>
        </div>
    </div>
</footer>
<style>
    .footer{
        width: 100%;
        max-width: 95%;
        margin: 3rem auto 0;
        /* Espacio para que el menú fijo inferior (móvil) no tape el copyright. */
        padding-bottom: 6rem;
    }
    .footer-card{
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        padding: 2rem 1.25rem;
        background: var(--color-dark);
        color: #f1f1f1;
        border-radius: var(--radius-card);
        font-size: clamp(var(--font-size-small),var(--font-size-medium),var(--font-size-desktop));
        line-height: var(--line-height-p);
        letter-spacing: var(--letter-spacing-text);
    }
    .footer-top{
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }
    .footer-logo{
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: var(--letter-spacing-h1);
        color: var(--color-button);
    }
    .footer-tagline{
        max-width: 28rem;
        color: rgba(241,241,241,.7);
    }
    hr{
        border: 0;
        border-top: 1px solid rgba(255,255,255,.1);
    }
    .footer-grid{
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.75rem 1.25rem;
    }
    .footer-grid h3{
        margin-bottom: .9rem;
        font-size: .85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05rem;
        color: var(--color-button);
    }
    .footer-grid ul{
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: .6rem;
    }
    address{
        font-style: normal;
    }
    address a{
        overflow-wrap: anywhere;
    }
    .footer-grid a,
    .dato{
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        color: rgba(241,241,241,.7);
        text-decoration: none;
    }
    .footer-grid nav a,
    address a{
        background-image: linear-gradient(var(--color-button), var(--color-button));
        background-size: 0 1px;
        background-repeat: no-repeat;
        background-position: left bottom;
        transition: color .3s var(--ease-out), background-size .3s var(--ease-out);
    }
    .footer-grid nav a:hover,
    address a:hover{
        color: #fff;
        background-size: 100% 1px;
    }
    .icono{
        display: inline-flex;
        color: var(--color-button);
    }
    .footer-redes ul{
        flex-direction: row;
        gap: .75rem;
    }
    .footer-redes a{
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 50%;
        color: #f1f1f1;
        transition: background-color .3s var(--ease-out), color .3s var(--ease-out), transform .3s var(--ease-out);
    }
    .footer-redes a:hover{
        background-color: var(--color-button);
        color: var(--color-text-button);
        transform: translateY(-2px);
    }
    .footer-grid a:focus-visible{
        outline: 3px solid var(--color-button);
        outline-offset: 3px;
    }
    .footer-bottom{
        display: flex;
        flex-direction: column;
        gap: .6rem;
        font-size: .85rem;
        color: rgba(241,241,241,.6);
    }
    .footer-original{
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }
    @media(min-width: 768px){
        .footer-card{
            padding: 2.5rem 2.5rem;
        }
        .footer-bottom{
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }
    @media(min-width: 1024px){
        .footer{
            max-width: 80rem;
            padding-bottom: 1.5rem;
        }
        .footer-card{
            padding: 3rem 4rem;
        }
        .footer-top{
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
        .footer-grid{
            grid-template-columns: repeat(3, 1fr) auto;
        }
    }
</style>
