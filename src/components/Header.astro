---
const currentPath = Astro.url.pathname
---
<header>
    <nav class="menu-nav">
        <div class="head">
            <span class="logo">ALTUM</span>
            <ul>
                <li><a href="/" class:list={[{active: currentPath === '/'}]}>Inicio</a></li>
                <li><a href="/about-us" class:list={[{active: currentPath === '/about-us'}]}>Acerca de Nosotros</a></li>
                <li><a href="/products"class:list={[{active: currentPath === '/products'}]}>Productos</a></li>
            </ul>
        </div>       
    </nav>
</header>
<style>
    header{
        display: flex;
        justify-content: center;
    }   
    .menu-nav{
        background-color: var(--color-bg);
        backdrop-filter: blur(16px) saturate (150%);  
        -webkit-backdrop-filter: blur(16px) saturate(150%);
        padding: 1.2rem 0rem;
        border: .1rem solid var(--color-border);
        border-radius: 5rem;
        width: 100%;
        max-width: 90%;
        box-sizing: border-box;
        position: fixed;
        bottom: .7rem;
        box-shadow: 1px 5px 5px 1px var(--color-box-shadow);
        z-index: 50;
    }
    .logo{
        display: none;
    }

    .menu-nav ul{
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-evenly;
        gap: .5rem;
    }
    .menu-nav li{
        list-style-type: none;
    }
    .menu-nav a{
        background-image: linear-gradient( to right, var(--color-text-a-hover)50%, var(--color-text-a) 50%);
        background-size: 200% 100%;
        background-position: right bottom;
        -webkit-background-clip: text;
        background-clip: text;
        text-decoration: none;
        color: transparent;
        font-family: Arial, Helvetica, sans-serif;
        font-size: clamp(var(--font-size-small), var(--font-size-medium), var(--font-size-desktop));
        transition: background-position 0.4s ease;
    }
    .menu-nav a:hover{
        background-position: left bottom;
    }
    .menu-nav a.active{
        color: var(--color-text-a-hover);
    }

    @media (min-width: 1024px){
        .menu-nav{
            max-width: 50%;
            bottom: auto;
            top: 1%;
            justify-content: space-between;
        }
        .logo{
            display: block;
        }
        .head{
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            margin: 0rem 1rem;
        }
        .menu-nav a{
            margin: 0rem .3rem;
        }
        .menu-nav a.active{
            color: var(--color-button);
        }
    @media(min-width: 1440px){
        .menu-nav a{
            margin: 0rem 1rem;
        }
    }
</style>