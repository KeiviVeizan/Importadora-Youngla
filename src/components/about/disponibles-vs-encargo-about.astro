---
import { PackageCheck, ShoppingBag, Check, Clock } from "@lucide/astro"
import SectionTitle from "../SectionTitle.astro"

// Para cambiar una tarjeta: edita este arreglo.
const opciones = [
    {
        icon: PackageCheck,
        etiqueta: "Ya en el sistema",
        titulo: "Productos disponibles",
        descripcion: "Productos que ya están en el sitio con su precio final en dólares, calculado con taxes y peso incluidos.",
        puntos: ["Precio final visible, sin cálculos", "No requiere anticipo del 50%", "Entrega más rápida"],
        destacada: false,
    },
    {
        icon: ShoppingBag,
        etiqueta: "A tu medida",
        titulo: "Pedido por encargo",
        descripcion: "¿No está en el sitio? Pídenos cualquier producto desde la página oficial de la marca y lo importamos para ti.",
        puntos: ["Cotizamos producto + taxes + peso", "Reservas con el 50% de anticipo", "Llega en 3 a 6 semanas"],
        destacada: true,
    },
]
---
<section class="opciones" aria-labelledby="opciones-titulo">
    <SectionTitle
        eyebrow="Dos formas de comprar"
        title="Disponible o por encargo"
        subtitle="Elige lo que ya tenemos listo o pídenos exactamente lo que buscas."
        id="opciones-titulo"
    />
    <div class="opciones-grid">
        {
            opciones.map((o, i) => (
                <article class:list={["opcion", { destacada: o.destacada }]} data-reveal style={`--reveal-delay:${i * 100}ms`}>
                    <span class="opcion__icono"><o.icon size="1.6rem" stroke-width={1.5} /></span>
                    <span class="opcion__etiqueta">{o.etiqueta}</span>
                    <h3>{o.titulo}</h3>
                    <p>{o.descripcion}</p>
                    <ul>
                        {o.puntos.map((p) => (
                            <li><Check size="1rem" stroke-width={2.5} />{p}</li>
                        ))}
                    </ul>
                </article>
            ))
        }
    </div>
    <p class="nota"><Clock size="1em" /> Tiempo estimado de un pedido por encargo: entre 3 y 6 semanas desde que se confirma.</p>
</section>
<style>
    .opciones{
        width: 100%;
        max-width: 90%;
        margin: 4rem auto;
    }
    .opciones-grid{
        display: grid;
        gap: 1rem;
        max-width: 60rem;
        margin: 0 auto;
    }
    .opcion{
        padding: 1.5rem;
        background: var(--color-gray-bg);
        border-radius: var(--radius-card);
    }
    .opcion.destacada{
        background: var(--color-dark);
        color: #fff;
    }
    .opcion__icono{
        display: inline-grid;
        place-items: center;
        width: 3.2rem;
        height: 3.2rem;
        border-radius: 1rem;
        background: #fff;
        color: var(--color-dark);
    }
    .destacada .opcion__icono{
        background: var(--color-button);
        color: var(--color-text-button);
    }
    .opcion__etiqueta{
        display: block;
        margin: 1rem 0 .3rem;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--color-muted);
    }
    .destacada .opcion__etiqueta{
        color: var(--color-button);
    }
    h3{
        font-size: 1.35rem;
        margin-bottom: .5rem;
    }
    .opcion p{
        line-height: 1.5;
        color: var(--color-muted);
        letter-spacing: var(--letter-spacing-text);
    }
    .destacada p{
        color: rgb(255 255 255 / .75);
    }
    ul{
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: .55rem;
        margin-top: 1.1rem;
    }
    li{
        display: flex;
        align-items: center;
        gap: .55rem;
        font-weight: 500;
        font-size: .95rem;
    }
    li :global(svg){
        flex: none;
        padding: .15rem;
        width: 1.3rem;
        height: 1.3rem;
        border-radius: 50%;
        background: var(--color-button);
        color: var(--color-text-button);
    }
    .nota{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin-top: 1.5rem;
        text-align: center;
        font-size: .9rem;
        color: var(--color-muted);
    }
    @media (min-width: 1024px){
        .opciones{
            max-width: 80rem;
        }
        .opciones-grid{
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }
        .opcion{
            padding: 2rem;
        }
    }
</style>
