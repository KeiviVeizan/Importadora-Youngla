---
import { Star } from "@lucide/astro"
import SectionTitle from "./SectionTitle.astro"

// Para cambiar un testimonio: edita este arreglo.
// "avatar" es opcional: si está vacío se muestra un círculo con la inicial.
// Sugerido: pon las fotos en public/images/clientes/ (ej. /images/clientes/andres.webp)
const testimonios = [
    { texto: "Mi hoodie de YoungLA llegó en 3 semanas, todo 100% original y la calidad increíble.", usuario: "@andres.f.fitness", avatar: "" },
    { texto: "Excelente atención, me ayudaron a conseguir exactamente lo que buscaba.", usuario: "@valee.training", avatar: "" },
    { texto: "Ya es mi tercera compra, súper confiables y recomendable al 100%.", usuario: "@javier.gym", avatar: "" },
]
---
<section class="testimonios" aria-labelledby="testimonios-titulo">
    <SectionTitle eyebrow="Clientes" title="Lo que dicen nuestros clientes" id="testimonios-titulo" />
    <ul class="testimonios-lista" data-carousel>
        {
            testimonios.map((t, i) => (
                <li class="testimonio" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                    <div class="estrellas" role="img" aria-label="5 de 5 estrellas">
                        {[0, 1, 2, 3, 4].map(() => <Star size="1rem" fill="currentColor" stroke-width={0} />)}
                    </div>
                    <blockquote>“{t.texto}”</blockquote>
                    <div class="cliente">
                        {
                            t.avatar
                                ? <img src={t.avatar} alt="" width="40" height="40" loading="lazy" decoding="async" />
                                : <span class="avatar-inicial" aria-hidden="true">{t.usuario.replace("@", "").charAt(0).toUpperCase()}</span>
                        }
                        <span class="cliente-usuario">{t.usuario}</span>
                    </div>
                </li>
            ))
        }
    </ul>
    <div class="dots" data-carousel-dots aria-hidden="true">
        {testimonios.map((_, i) => <button type="button" tabindex="-1" class:list={["dot", { activo: i === 0 }]} data-index={i}></button>)}
    </div>
</section>
<style>
    .testimonios{
        width: 100%;
        max-width: 90%;
        margin: 3rem auto;
    }
    .testimonios-lista{
        list-style: none;
        display: flex;
        gap: .9rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: .25rem 0 .5rem;
        scrollbar-width: none;
    }
    .testimonios-lista::-webkit-scrollbar{
        display: none;
    }
    .testimonio{
        flex: 0 0 82%;
        scroll-snap-align: center;
        display: flex;
        flex-direction: column;
        gap: .9rem;
        padding: 1.25rem;
        background: #fff;
        border: 1px solid var(--color-border-soft);
        border-radius: var(--radius-card);
    }
    .estrellas{
        display: flex;
        gap: .15rem;
        color: var(--color-button);
        /* El lima sobre blanco tiene poco contraste: se refuerza con un contorno oscuro suave */
        filter: drop-shadow(0 0 .5px rgba(22,29,8,.6));
    }
    .testimonio blockquote{
        flex: 1;
        font-size: .95rem;
        line-height: 1.5;
        color: var(--color-dark);
        letter-spacing: var(--letter-spacing-text);
    }
    .cliente{
        display: flex;
        align-items: center;
        gap: .6rem;
    }
    .cliente img,
    .avatar-inicial{
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        object-fit: cover;
    }
    .avatar-inicial{
        display: grid;
        place-items: center;
        background: var(--color-dark);
        color: var(--color-button);
        font-weight: 700;
    }
    .cliente-usuario{
        font-size: .85rem;
        color: var(--color-muted);
    }
    .dots{
        display: flex;
        justify-content: center;
        gap: .5rem;
        margin-top: 1rem;
    }
    .dot{
        width: .55rem;
        height: .55rem;
        padding: 0;
        border: 0;
        border-radius: 1rem;
        background: var(--color-border-soft);
        cursor: pointer;
        transition: width .3s var(--ease-out), background-color .3s;
    }
    .dot.activo{
        width: 1.4rem;
        background: var(--color-button);
    }
    @media(min-width: 768px){
        .testimonios-lista{
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            overflow: visible;
            gap: 1.25rem;
            padding: 0;
        }
        .testimonio{
            flex: initial;
        }
        .dots{
            display: none;
        }
    }
    @media(min-width: 1024px){
        .testimonios{
            max-width: 80rem;
        }
    }
</style>
